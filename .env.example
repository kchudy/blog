# Copy to .env for local development; docker-compose.yml sets these for the deployed containers.
DJANGO_SECRET_KEY=change-me
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Defaults to a local sqlite3 file if unset. docker-compose.yml points this at a volume-mounted
# file instead so data persists across container recreations:
# DATABASE_URL=sqlite:////data/db.sqlite3
