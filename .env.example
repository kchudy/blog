# Copy to .env for local development; docker-compose.yml sets these for the deployed containers.
DJANGO_SECRET_KEY=change-me
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Defaults to a local sqlite3 file if unset. Example for Postgres (as used in docker-compose.yml):
# DATABASE_URL=postgres://blog:blog@db:5432/blog
